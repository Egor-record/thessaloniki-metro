
---
const currentLang  = Astro.url.pathname.startsWith('/en') ? 'en' : 'el';

const content = {
    en : {
        text : "We do not share your data with third-party companies. We use cookies to track the number of visitors and the city they came from.",
        button: "Fine"
    },
    el: {
        text : "Δεν κοινοποιούμε τα δεδομένα σας σε τρίτες εταιρείες. Χρησιμοποιούμε cookies για την παρακολούθηση του αριθμού των επισκεπτών και της πόλης από την οποία προήλθαν.",
        button: "Εντάξει"
    }
}

---
<div class="als-cookie-button" id="als-cookie-box">
    <div>{ content[currentLang].text }
        <button id="accept-cookies">{ content[currentLang].button }</button>
    </div>
</div>
<script>
  const handleCookie = () => {
    const url = window.location.href;
    const PAGE_NAME = getPageName(url);
    const TRACKER_ID = '700961';
    const COOKIE_NAME = 'nocookieMetro'
    function getPageName(url: string): string {
        const path = new URL(url).pathname.split('/').filter(Boolean);
        const first = path[0];
        const isLang = /^[a-z]{2}$/.test(first);
        return isLang ? path[1] ?? 'index' : first ?? 'index';
    }
    const createTrackerBox = (sessionId : string) => {
        const img = document.createElement('img');
        img.src = `https://borisbot.site/watch/${TRACKER_ID}/${PAGE_NAME}?sessionId=${sessionId}`;
        img.alt = 'This is activity tracker';
        img.style.position = 'absolute';
        img.style.left = '-9999px';

        document.body.appendChild(img);
    }
    const initTrackerBox = () => {
        let sessionId = sessionStorage.getItem('sessionId');
        if (!sessionId) {
            sessionId = Math.floor(Math.random() * 1_000_000_000).toString()
            sessionStorage.setItem('sessionId', sessionId);
            createTrackerBox(sessionId);
        } else {
            createTrackerBox(sessionId);
        }
    }
    const cookieBox = document.getElementById('als-cookie-box');
    const cookieAccepted = document.cookie.includes(COOKIE_NAME + '=true');

    if (!cookieAccepted) {
        if (cookieBox) cookieBox.classList.add('show');
    } else {
        initTrackerBox()
    }
    const acceptBtn = document.getElementById('accept-cookies');

    if (acceptBtn) {
        acceptBtn.addEventListener('click', () => {
            document.cookie = COOKIE_NAME + "=true; max-age=" + (60 * 60 * 24 * 365) + "; path=/";
            if (cookieBox) {
                cookieBox.classList.remove('show');
                initTrackerBox()
            }
        });
    }
}
handleCookie();

</script>
<style>
.als-cookie-button {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    transform: translate3d(0, 110%, 0);
    opacity: 0;
    z-index: 11;
    text-align: left;
    width: 100%;
    font-size: 16px;
}
.als-cookie-button.show {
    transform: translate3d(0, 0, 0);
    opacity: 1;
}
@media (max-width: 900px) {
    .als-cookie-button {
        font-size: 15px;
    }
}
@media (max-width: 700px) {
.als-cookie-button {
        font-size: 14px;
    }
}
.als-cookie-button div {
    background: #3c90cb;
    color: #fff;
    padding: 1.5em 21em 1.5em 2em;
    cursor: pointer;
    position: relative;
    transition: all .3s;
}
.als-cookie-button {
    transition: all .4s cubic-bezier(.165,.84,.44,1);
}
@media (max-width: 700px) {
    .als-cookie-button div {
        padding-right: 1em;
        padding-left: 1em;
    }
}

.als-cookie-button button {
    background: rgba(255, 255, 255, .2);
    font-size: inherit;
    font-family: inherit;
    border-radius: 50px;
    border: none;
    color: inherit;
    outline: 0;
    display: block;
    position: absolute;
    right: 20px;
    top: 1em;
    bottom: 1em;
    cursor: pointer;
    padding: 0 3em;
    transition: all .3s;
}

@media (max-width: 700px) {
    .als-cookie-button button {
        position: static;
        display: block;
        padding: 1em;
        text-align: center;
        width: 100%;
        margin-top: .5em;
    }
}
</style>