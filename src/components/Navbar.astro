---
import type { Language } from '../types/global';
interface Props {
	currentLang: Language;
}

const { currentLang } = Astro.props;

const greekPath = Astro.url.pathname.replace(/^\/en/, '') || '/';
const englishPath = '/en' + (Astro.url.pathname === '/' ? '' : Astro.url.pathname);

const menuItems : Record<Language, string[]> = {
  en: ['Map', 'How to Pay', 'For Passengers', 'News', 'About Metro', 'Contacts'],
  el: ['Χάρτης', 'Πώς να πληρώσετε', 'Για επιβάτες', 'Νέα', 'Σχετικά με το Μετρό', 'Επικοινωνία'],
};

const getPath = (item : string, index : number) => {
  return currentLang === 'en' 
    ? `/${currentLang}/${item.toLowerCase().replace(/\s/g, '')}`
    : `/${menuItems.en[index].toLowerCase().replace(/\s/g, '')}`;
};

const currentMenuItems = menuItems[currentLang] || menuItems['el'];
---
<nav class="navbar navbar-expand-lg">
  <div class="container-fluid">
      <a class="navbar-brand" href="/">  
          <img src="/icons/logo_small.png" height=100 class="d-inline-block align-text-top" alt="Metro Thessaloniki unofficial Logo" />
          {currentLang === 'en' ? (
          <div class="metro-title small">Metro Thessaloniki</div>
      ) : (
          <div class="metro-title small">Μετρό Θεσσαλονίκης</div>
      )}
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarSupportedContent">
        <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
          {currentMenuItems.map((item, index) => {
            const path = getPath(item, index);
            return (
              <li class="nav-item">
                <a class={`nav-link ${Astro.url.pathname.startsWith(path) ? 'active' : ''}`} href={path}>
                  {item}
                </a>
              </li>
            );
          })}
          {currentLang === 'en' ? (
            <li class="nav-item">
              <a class="nav-link" href={greekPath}>Ελ 🇬🇷</a>
            </li>
          ) : (
          <li class="nav-item">
            <a class="nav-link" href={englishPath}>En 🇬🇧</a>
          </li>
          )}
        </ul>
      </div>
    </div>
  </nav>
  <style>
    .metro-title {
      position: relative;
    }
    .metro-title::after {
      color: #005b92;
      content: "Unofficial";
      font-weight: 700;
      font-size: 10px;
      position: absolute;
      top: -7px;
  }
    .navbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 20px;
        max-width: 1200px;
        margin: auto;
    }

    .logo {
        display: flex;
        align-items: center;
        flex-direction: column;
        gap: 6px;
    }

    .logo img {
        height: 100px;
        margin-right: 10px;
    }

    .menu {
        list-style: none;
        display: none;
        margin: 0;
        padding: 0;
    }

    @media screen and (min-width: 768px) {
      .menu {
        display: flex;
      }
    }

    .menu li {
        margin-right: 20px;
        position: relative;
    }

    .menu li a {
        text-decoration: none;
        color: #333;
    }

    .menu .dropdown:hover .dropdown-menu {
        display: block;
    }

    .menu .dropdown-menu {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        background-color: var(--main-white-color);
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        list-style: none;
        padding: 10px;
    }

    .menu .dropdown-menu li {
        margin: 0;
    }

    .menu .dropdown-menu li a {
        color: #333;
    }

    .login-btn {
        background-color: #e70000;
        color: var(--main-white-color);
        padding: 10px 20px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }

    .login-btn:hover {
        background-color: #cc0000;
    }
  </style>