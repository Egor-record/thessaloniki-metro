---
import type { Language, Translations } from '../types/global';
interface Props {
	lang: Language;
}
const { lang } = Astro.props;
const $t: Translations = {
    el: {
        logo: 'Μετρό Θεσσαλονίκης',
        about: 'Δημιουργία, σχεδιασμός, σύλληψη και ανάπτυξη του έργου:',
        egor: 'Εγκόρ Σιάσκοφ',
        about2: 'Επιπλέον υλικά, προτάσεις, σχόλια και διορθώσεις είναι ευπρόσδεκτα στη διεύθυνση:'

    },
    en : {
        logo: 'Metro Thessaloniki',
        about: 'Creation, design, concept, and project development:',
        egor: 'Egor Siaskov',
        about2: 'Additional materials, suggestions, comments, and corrections are welcome at:'
    }
}
---

<footer class="pt-5 pb-5 bg-white">
    <div class="container">
        <div class="row">
            <div class="col-12 col-md-3 d-flex mb-3">
                <a class="navbar-brand text-center" href="/">  
                    <img src="/icons/logo_small.png" height=50 alt="Metro Thessaloniki unofficial Logo" />
                    <div class="metro-title small">{$t[lang].logo}</div>
                </a>
            </div>
            <div class="col-12 col-md-9">
                {$t[lang].about}  <a href="https://e922.ru/about/" target="_blank">{$t[lang].egor}</a><br>
                {$t[lang].about2} <a href="mailto:mailbox@thessaloniki-metro.gr">mailbox@thessaloniki-metro.gr</a>
            </div>
        </div>
    </div>
</footer>