---
import HeroImage from '../components/HeroImage.astro';
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import ContactBlock from '../components/ContactBlock.astro';


type Language = 'en' | 'el';
interface data {
	title: string;
	description: string,
	lang: Language
}

const data = {
	title: 'Επικοινωνήστε με το Μετρό Θεσσαλονίκης',
	description: "Επικοινωνήστε με την ομάδα του Μετρό Θεσσαλονίκης για ερωτήσεις, υποστήριξη ή σχόλια σχετικά με το σύστημα και τις υπηρεσίες του μετρό.",
	lang: "el" as Language,
}

---

<Layout title={data.title}  description={data.description} isSmall={true}>
	<main>
		<HeroImage imgSrc="/photos/sky.jpg" headingText={data.title} />
		<ContactBlock lang="el">
	</main>
	<Footer lang={data.lang} />
</Layout>
<style>

</style>
