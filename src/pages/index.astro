---
import Layout from '../layouts/Layout.astro';
import Journeyplanner from '../components/Journeyplanner/Journeyplanner.vue';
import NewsHighlights from '../components/NewsHighlights.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro'

type Language = 'en' | 'el';
interface SiteMetaData {
	title: string;
	description: string,
	lang: Language
}

const data : SiteMetaData = {
	title: 'Μετρό Θεσσαλονίκης',
	description: "Ανακαλύψτε τα τελευταία νέα, χάρτες και ενημερώσεις για το Μετρό Θεσσαλονίκης. Οδηγός για τις διαδρομές, τους σταθμούς και ό,τι πρέπει να γνωρίζετε για το νέο μετρό.",
	lang: "el" as Language,
}

---

<Layout title={data.title}  description={data.description} isSmall={false}>
	<main class="bg-blue">
		<Journeyplanner client:load lang={data.lang} withRedirect={true} />
		<NewsHighlights lang={data.lang} />
		<Faq lang={data.lang} />
		<Footer lang={data.lang} />
	</main>
</Layout>
