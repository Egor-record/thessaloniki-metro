---
import Layout from '../layouts/Layout.astro';
import Journeyplanner from '../components/Journeyplanner/Journeyplanner.vue';
import NewsHighlights from '../components/NewsHighlights.astro';
import Faq from '../components/Faq.astro';

type Language = 'en' | 'el';
interface SiteMetaData {
	title: string;
	description: string,
	lang: Language
}

const data : SiteMetaData = {
	title: 'Μετρό Θεσσαλονίκης',
	description: "Ανακαλύψτε τα τελευταία νέα, χάρτες και ενημερώσεις για το Μετρό Θεσσαλονίκης. Οδηγός για τις διαδρομές, τους σταθμούς και ό,τι πρέπει να γνωρίζετε για το νέο μετρό.",
	lang: "el" as Language,
}

---

<Layout title={data.title}  description={data.description}>
	<main>
		<Journeyplanner client:load lang={data.lang}/>
		<NewsHighlights lang={data.lang} />
		<Faq lang={data.lang} />
		<footer class="pt-5 pb-5 bg-white">
			<div class="container">
				<div class="row">
					<div class="col-12 col-md-3 d-flex mb-3">
						<a class="navbar-brand text-center" href="/">  
							<img src="/icons/logo_small.png" height=50 alt="Metro Thessaloniki unofficial Logo" />
							<div class="metro-title small">Μετρό Θεσσαλονίκης</div>
						</a>
					</div>
					<div class="col-12 col-md-9">
						Δημιουργία, σχεδιασμός, σύλληψη και ανάπτυξη του έργου: Εγκόρ Σιάσκοφ <br>
						Επιπλέον υλικά, προτάσεις, σχόλια και διορθώσεις είναι ευπρόσδεκτα στη διεύθυνση: <a href="mailto:mailbox@thessaloniki-metro.gr">mailbox@thessaloniki-metro.gr</a>
					</div>
				</div>
			
			</div>
		</footer>
	</main>
</Layout>
<style>
	main {
		background: linear-gradient(150deg,#00477f 0,#459BD6 100%);
	}
</style>
