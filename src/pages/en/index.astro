---
import Layout from '../../layouts/Layout.astro';
import Journerplanner from '../../components/Journeyplanner/Journeyplanner.vue';
import NewsHighlights from '../../components/NewsHighlights.astro';
import Faq from '../../components/Faq.astro';
import Footer from '../../components/Footer.astro'
import { withDelays } from '../../utils/globalConst';

type Language = 'en' | 'el';
interface data {
	title: string;
	description: string,
	lang: Language
}

const data = {
	title: "Thessaloniki Metro",
	description: "Discover the latest news, maps, and updates about the Thessaloniki Metro. Your guide to routes, stations, and everything you need to know about Thessaloniki's upcoming subway.",
	lang : 'en' as Language,
}

const isDelayed = await withDelays()

---

<Layout title={data.title} description={data.description} isSmall={false}>
	<main>
		<Journerplanner  client:load  lang={data.lang} withRedirect={true} withDelays={isDelayed} />
		<NewsHighlights lang={data.lang} />
		<Faq lang={data.lang} />
		<Footer lang={data.lang} />
	</main>
</Layout>
<style>
	main {
		background: linear-gradient(150deg,#00477f 0,#459BD6 100%);
	}
</style>