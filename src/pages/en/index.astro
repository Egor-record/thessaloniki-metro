---
import Layout from '../../layouts/Layout.astro';
import Journerplanner from '../../components/Journeyplanner.vue';
import NewsHighlights from '../../components/NewsHighlights.astro';
import Faq from '../../components/Faq.astro';

type Language = 'en' | 'el';
interface data {
	title: string;
	description: string,
	lang: Language
}

const data = {
	title: "Thessaloniki Metro",
	description: "Discover the latest news, maps, and updates about the Thessaloniki Metro. Your guide to routes, stations, and everything you need to know about Thessaloniki's upcoming subway.",
	lang : 'en' as Language,
}

---

<Layout title={data.title} description={data.description}>
	<main>
		<Journerplanner lang={data.lang}/>
		<NewsHighlights lang={data.lang} />
		<Faq lang={data.lang} />
		<footer class="pt-5 pb-5 bg-white">
			<div class="container">
				<div class="row">
					<div class="col-12 col-md-3 d-flex mb-3">
						<a class="navbar-brand text-center" href="/">  
							<img src="/icons/logo_small.png" height=50 alt="Metro Thessaloniki unofficial Logo" />
							<div class="metro-title small">Metro Thessaloniki</div>
						</a>
					</div>
					<div class="col-12 col-md-9">
						Creation, design, concept, and project development: Egor Siaskov <br>
						Additional materials, suggestions, comments, and corrections are welcome at: <a href="mailto:mailbox@thessaloniki-metro.gr">mailbox@thessaloniki-metro.gr</a>
					</div>
				</div>
			
			</div>
		</footer>
	</main>
</Layout>
<style>
	main {
		background: linear-gradient(150deg,#00477f 0,#459BD6 100%);
	}
</style>