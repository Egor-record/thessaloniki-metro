---
import Layout from '../../layouts/Layout.astro';
import HeroImage from '../../components/HeroImage.astro';
import Footer from '../../components/Footer.astro';
import ContactBlock from '../../components/ContactBlock.astro';

type Language = 'en' | 'el';
interface data {
	title: string;
	description: string,
	lang: Language
}

const data = {
	title: 'Contact the Thessaloniki Metro',
	description: "Get in touch with the Thessaloniki Metro team for inquiries, support, or feedback about the metro system and services.",
	lang: "en" as Language,
}

---

<Layout title={data.title}  description={data.description} isSmall={true}>
	<main>
		<HeroImage imgSrc="/photos/sky.jpg" headingText={data.title} />
		<ContactBlock lang="en" />
	</main>
	<Footer lang={data.lang} />
</Layout>
