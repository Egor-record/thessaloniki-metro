---
import Layout from '../../layouts/Layout.astro';


type Language = 'en' | 'el';
interface data {
	title: string;
	description: string,
	lang: Language
}

const data = {
	title: 'Thessaloniki Metro Map',
	description: "Explore the complete map of the Thessaloniki Metro. Find all routes, stations, and connections to plan your journey efficiently.",
	lang: "el" as Language,
}

---

<Layout title={data.title}  description={data.description}>
	<main>
        <h1 class="text-center">{data.title}</h1>
		<section class="text-center">
			<img src="/icons/map.svg" class="img-fluid" alt="Metro of Thessaloniki" />
		</section>
	</main>
</Layout>
<style>

</style>
