---
import Layout from '../../layouts/Layout.astro';
import MapImage from '../../components/Map/Map.vue';
import Journerplanner from '../../components/Journeyplanner/Journeyplanner.vue';
import Footer from '../../components/Footer.astro'

type Language = 'en' | 'el';
interface data {
	title: string;
	description: string,
	lang: Language
}

const data = {
	title: 'Thessaloniki Metro Map',
	description: "Explore the complete map of the Thessaloniki Metro. Find all routes, stations, and connections to plan your journey efficiently.",
	lang: "el" as Language,
}

---

<Layout title={data.title}  description={data.description} isSmall={true}>
	<main>
        <h1 class="text-center">{data.title}</h1>
		<section class="text-center">
			<MapImage client:load lang={"en"}/>
		</section>
		<Journerplanner client:load lang={"en"} withRedirect={false} class="bg-blue mt-5"/>
		<Footer lang={"en"} />
	</main>
</Layout>
<style>

</style>
