---
import Layout from '../layouts/Layout.astro';
import MapImage from '../components/Map/Map.vue';
import Journeyplanner from '../components/Journeyplanner/Journeyplanner.vue';
import SeoText from '../components/Map/SeoText.astro';
import Footer from '../components/Footer.astro'
import { withDelays } from '../utils/globalConst';

type Language = 'en' | 'el';
interface data {
	title: string;
	description: string,
	lang: Language
}

const data = {
	title: 'Χάρτης Μετρό Θεσσαλονίκης',
	description: "Εξερευνήστε τον πλήρη χάρτη του Μετρό Θεσσαλονίκης. Βρείτε όλες τις διαδρομές, σταθμούς και συνδέσεις για να σχεδιάσετε το ταξίδι σας αποτελεσματικά.",
	lang: "el" as Language,
}

const isDelayed = await withDelays()
---

<Layout title={data.title}  description={data.description} isSmall={true}>
	<main>
        <h1 class="text-center">{data.title}</h1>
		<section class="text-center">
			<MapImage client:load />
		</section>
		<Journeyplanner client:load lang={data.lang} withRedirect={false} withDelays={isDelayed} class="bg-blue mt-5"/>
		<SeoText lang={"el"} />
		<Footer lang={data.lang} />
	</main>
</Layout>
<style>

</style>
