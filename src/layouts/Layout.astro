---
import Navbar from '../components/Navbar.astro';
import CookieBox from '../components/CookieBox.astro';

const currentLang  = Astro.url.pathname.startsWith('/en') ? 'en' : 'el';

interface Props {
	title: string;
	description: string;
	isSmall: boolean
}
const { title, description, isSmall } = Astro.props;

---
<!doctype html>
<html lang={currentLang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image" href="/icons/logo_small.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
	</head>
	<body>
		<Navbar currentLang={currentLang} isSmall={isSmall} />
		<slot />
		<CookieBox  currentLang={currentLang} />
		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
	</body>
</html>
<script>
console.log(
	"%cMetro Thessaloniki Fan Site\n\n" +
	"%cVersion: %c1.0.0\n\n" +
	"%cTo report an issue, visit:\n%chttps://github.com/Egor-record/thessaloniki-metro/issues\n\n" +
	"%cFor communication: %cmailbox@thessaloniki-metro.gr\n",
	"font-size: 16px; font-weight: bold; color: #2d85c4;",
);
</script>
<style is:global>
	@import url('https://fonts.googleapis.com/css2?family=Inter:ital,opsz@0,14..32;1,14..32&family=Roboto&display=swap');
	:root {
		--main-white-color: white;
		--blue-gradient: linear-gradient(150deg,#00477f 0,#459BD6 100%);
	}
	@font-face {
		font-family: "Roboto", sans-serif;
		font-weight: 400;
		font-style: normal;
	}

	@font-face {
		font-family: "Inter", sans-serif;
		font-optical-sizing: auto;
		font-weight: 400;
		font-style: normal;
	}

	body {
		font-family: "Inter", sans-serif;
		margin: 0;
		color: #1C2930
	}

	h1, h2, h3 {
		font-family: "Roboto", sans-serif;
	}
	.text-center {
		text-align: center;
	}
	.color-white {
		color: white
	}
	.is-relative {
		position: relative;
	}

	.is-absolute {
		position: absolute;
	}

	.bg-blue {
		background: var(--blue-gradient)
	}

	.metro-title {
      position: relative;
    }
    .metro-title::after {
      color: #005b92;
      content: "Fansite";
      font-weight: 700;
      font-size: 10px;
      position: absolute;
      top: -7px;
      right: 0;
  }
</style>
